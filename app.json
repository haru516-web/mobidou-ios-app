{
  "expo": {
    "name": "もび道",
    "slug": "mobidou",
    "scheme": "mobidou",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.mobby.mobidou",
      "appleTeamId": "473V9BLJ33",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": ["group.jp.mobby.mobidou"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"] }
        ]
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "今日の歩数を読み取り、もびの世界の御朱印を集めるために使用します。歩数は端末に保存します。Apple IDとつないだ場合は、機種変更で記録を戻すため、歩数の合計をサーバーに保存します。イベントにチームで出発した場合は、チームの歩数を合わせるため、その日の歩数の合計をサーバーに送ります。広告や分析には使いません。",
        "NSHealthUpdateUsageDescription": "ヘルスケアへの書き込みは行いません。歩数の読み取りの許可を求める処理のために、この説明を表示します。",
        "NSMotionUsageDescription": "今日の歩数を読み取り、歩いた分だけ御朱印を集めるために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "歩数に合わせて、もびの世界の御朱印を集めるために使用します。"
        }
      ],
      "expo-asset",
      "expo-iap",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false }]
    ],
    "web": {
      "bundler": "metro",
      "name": "もび道 — 歩く、集める、好きになる。"
    },
    "extra": {
      "widgetAppGroup": "group.jp.mobby.mobidou",
      "eas": {
        "projectId": "bfdcaf4d-9b6e-4016-a0ae-be4d6dbdf2ed"
      }
    },
    "owner": "obana.h",
    "icon": "./assets/icon.png"
  }
}
